/*Consulta 6: Nombre, precio inicial, precio final y diferencia*/

SELECT Nombre,
       PriceInitial,
       PriceFinal,
       PriceInitial - PriceFinal AS Diferencia
FROM dbo.juegos;

/*Consulta 7: ¿Cuántos juegos hay del siglo pasado?*/

SELECT COUNT(*) AS TotalJuegos
FROM dbo.juegos
WHERE TRY_CONVERT(INT, ReleaseDate) < YEAR(GETDATE()) - 100;

/*Consulta 8: Juegos cuyos nombres terminen en N o en O*/

SELECT *
FROM dbo.juegos
WHERE RTRIM(Nombre) LIKE '%N'
   OR RTRIM(Nombre) LIKE '%O';

   /*Consulta 9: Juegos que empiecen por A y se puedan jugar con mando*/

   SELECT *
FROM dbo.juegos
WHERE LTRIM(Nombre) LIKE 'A%'
  AND ControllerSupport = 'True';

  /*Consulta 10: Juegos publicados entre 2000 y 2010*/

  SELECT *
FROM dbo.juegos
WHERE TRY_CONVERT(INT, ReleaseDate) BETWEEN 2000 AND 2010;
